<odoo>
  <record id="rule_policy_company" model="ir.rule"><field name="name">Politique : sociétés autorisées</field><field name="model_id" ref="model_sale_margin_automation_policy"/><field name="domain_force">[('company_id', 'in', company_ids)]</field></record>
  <record id="rule_job_company" model="ir.rule"><field name="name">Traitements : sociétés autorisées</field><field name="model_id" ref="model_sale_margin_automation_job"/><field name="domain_force">[('company_id', 'in', company_ids)]</field></record>
  <record id="rule_event_company" model="ir.rule"><field name="name">Événements : sociétés autorisées</field><field name="model_id" ref="model_sale_margin_automation_event"/><field name="domain_force">[('company_id', 'in', company_ids)]</field></record>
  <record id="rule_run_company" model="ir.rule"><field name="name">Exécutions : sociétés autorisées</field><field name="model_id" ref="model_sale_margin_automation_run"/><field name="domain_force">[('company_id', 'in', company_ids)]</field></record>
  <record id="rule_job_sales_own" model="ir.rule"><field name="name">Traitements : commercial destinataire</field><field name="model_id" ref="model_sale_margin_automation_job"/><field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]"/><field name="domain_force">[('recipient_id', '=', user.id)]</field></record>
  <record id="rule_job_manager_all" model="ir.rule"><field name="name">Traitements : approbateur</field><field name="model_id" ref="model_sale_margin_automation_job"/><field name="groups" eval="[(4, ref('sale_margin_approval.group_approver'))]"/><field name="domain_force">[(1, '=', 1)]</field></record>
  <record id="rule_job_runner" model="ir.rule"><field name="name">Traitements : compte désigné</field><field name="model_id" ref="model_sale_margin_automation_job"/><field name="groups" eval="[(4, ref('group_runner'))]"/><field name="domain_force">[('policy_id.runner_id', '=', user.id)]</field></record>
  <record id="rule_policy_runner" model="ir.rule"><field name="name">Politique : compte désigné</field><field name="model_id" ref="model_sale_margin_automation_policy"/><field name="groups" eval="[(4, ref('group_runner'))]"/><field name="domain_force">[('runner_id', '=', user.id)]</field></record>
  <record id="rule_policy_manager" model="ir.rule"><field name="name">Politique : approbateur</field><field name="model_id" ref="model_sale_margin_automation_policy"/><field name="groups" eval="[(4, ref('sale_margin_approval.group_approver'))]"/><field name="domain_force">[(1, '=', 1)]</field></record>
  <record id="rule_approval_runner" model="ir.rule"><field name="name">Approbations : lecture technique</field><field name="model_id" ref="sale_margin_approval.model_sale_margin_approval"/><field name="groups" eval="[(4, ref('group_runner'))]"/><field name="domain_force">[('company_id', 'in', company_ids)]</field></record>
</odoo>
