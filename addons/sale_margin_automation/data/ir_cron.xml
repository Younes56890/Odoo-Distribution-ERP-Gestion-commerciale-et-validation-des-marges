<odoo noupdate="1">
  <record id="cron_discover" model="ir.cron">
    <field name="name">Marges : détecter les suivis internes</field>
    <field name="model_id" ref="model_sale_margin_automation_engine"/>
    <field name="state">code</field><field name="code">model._cron_discover()</field>
    <field name="user_id" ref="user_automation"/>
    <field name="interval_number">15</field><field name="interval_type">minutes</field>
    <field name="numbercall">-1</field><field name="doall" eval="False"/><field name="active" eval="False"/>
  </record>
  <record id="cron_process" model="ir.cron">
    <field name="name">Marges : exécuter les suivis internes</field>
    <field name="model_id" ref="model_sale_margin_automation_engine"/>
    <field name="state">code</field><field name="code">model._cron_process()</field>
    <field name="user_id" ref="user_automation"/>
    <field name="interval_number">5</field><field name="interval_type">minutes</field>
    <field name="numbercall">-1</field><field name="doall" eval="False"/><field name="active" eval="False"/>
  </record>
</odoo>
