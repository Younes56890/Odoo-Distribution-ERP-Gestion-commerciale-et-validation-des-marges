<odoo>
  <record id="policy_tree" model="ir.ui.view"><field name="name">sale.margin.automation.policy.tree</field><field name="model">sale.margin.automation.policy</field><field name="arch" type="xml"><tree delete="0"><field name="company_id"/><field name="enabled"/><field name="reminder_hours"/><field name="report_frequency"/><field name="runner_id"/></tree></field></record>
  <record id="policy_form" model="ir.ui.view"><field name="name">sale.margin.automation.policy.form</field><field name="model">sale.margin.automation.policy</field><field name="arch" type="xml"><form delete="0"><header><button name="action_run" type="object" string="Exécuter un lot" class="oe_highlight" invisible="not enabled"/></header><sheet>
    <div class="alert alert-info" role="status">Suivi interne uniquement. Aucune approbation, confirmation ou transmission au client automatique. Les tâches planifiées doivent être activées séparément par l’administrateur.</div>
    <group><group><field name="company_id" readonly="id"/><field name="enabled"/><field name="activation_from"/><field name="runner_id"/><field name="recipient_ids" widget="many2many_tags" domain="[('share', '=', False), ('active', '=', True)]"/></group><group><field name="notifications_enabled"/><field name="reminder_hours"/><field name="pdf_enabled"/><field name="reports_enabled"/><field name="report_frequency"/><field name="timezone"/></group></group><group string="Exécution"><field name="batch_size"/><field name="max_attempts"/><field name="retry_delay_minutes"/><field name="report_cursor"/></group>
  </sheet></form></field></record>
  <record id="job_tree" model="ir.ui.view"><field name="name">sale.margin.automation.job.tree</field><field name="model">sale.margin.automation.job</field><field name="arch" type="xml"><tree create="0" edit="0" delete="0" decoration-danger="state == 'failed'"><field name="create_date"/><field name="name"/><field name="kind"/><field name="state"/><field name="attempts"/><field name="recipient_id"/><field name="company_id"/></tree></field></record>
  <record id="job_form" model="ir.ui.view"><field name="name">sale.margin.automation.job.form</field><field name="model">sale.margin.automation.job</field><field name="arch" type="xml"><form create="0" edit="0" delete="0"><header><button name="action_retry" type="object" string="Demander une reprise" invisible="state != 'failed'" groups="sale_margin_approval.group_approver"/></header><sheet><group><field name="name"/><field name="kind"/><field name="state"/><field name="policy_id"/><field name="order_id"/><field name="approval_id"/><field name="recipient_id"/><field name="attempts"/><field name="next_attempt_at"/><field name="finished_at"/><field name="error_code"/><field name="result"/><field name="artifact_id"/></group></sheet><div class="oe_chatter"><field name="message_follower_ids"/><field name="activity_ids"/><field name="message_ids"/></div></form></field></record>
  <record id="run_tree" model="ir.ui.view"><field name="name">sale.margin.automation.run.tree</field><field name="model">sale.margin.automation.run</field><field name="arch" type="xml"><tree create="0" edit="0" delete="0"><field name="started_at"/><field name="finished_at"/><field name="kind"/><field name="state"/><field name="job_id"/><field name="attempt"/><field name="triggered_by"/><field name="error_code"/><field name="detail"/></tree></field></record>
  <record id="policy_action" model="ir.actions.act_window"><field name="name">Politiques de suivi</field><field name="res_model">sale.margin.automation.policy</field><field name="view_mode">tree,form</field></record>
  <record id="job_action" model="ir.actions.act_window"><field name="name">Traitements internes</field><field name="res_model">sale.margin.automation.job</field><field name="view_mode">tree,form</field></record>
  <record id="run_action" model="ir.actions.act_window"><field name="name">Journal d’exécution</field><field name="res_model">sale.margin.automation.run</field><field name="view_mode">tree</field></record>
  <menuitem id="menu_automation" name="Suivi automatique" parent="sale.sale_menu_root" sequence="65" groups="sale_margin_approval.group_approver"/>
  <menuitem id="menu_policy" name="Politiques" parent="menu_automation" action="policy_action"/>
  <menuitem id="menu_job" name="Traitements" parent="menu_automation" action="job_action"/>
  <menuitem id="menu_run" name="Journal" parent="menu_automation" action="run_action"/>
</odoo>
